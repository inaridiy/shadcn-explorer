# cp .dev.vars.example .dev.vars
# local: D1 FTS5 + フェイク AI で API キー無しに動かす。実サービスを使う場合は cloudflare
EXPLORER_MODE=local
BETTER_AUTH_SECRET=replace-with-32+-random-chars-replace-with-32
BETTER_AUTH_URL=http://localhost:3000
# 運営者 (登録・再同期・再生成・プレビュー設定・/admin)。ログイン後に select id, email from user で調べる
# ADMIN_USER_IDS=...
# GEMINI_API_KEY=...
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...
# AGENTS_API_URL=https://cf-open-agents-api.<account>.workers.dev
# AGENTS_API_TOKEN=...
# OPENAI_API_KEY=sk-...   # Agents API が無いとき gpt-6-luna で直接ドキュメント生成
# OPENAI_MODEL=gpt-6-luna
# v0.7 取り込みのライフサイクル (ローカルでは公式ディレクトリの自動取り込みは既定で off)
# DIRECTORY_INTAKE=on
# DIRECTORY_INTAKE_PER_RUN=1
# OpenAI の無料枠 (README「LLM と OpenAI の無料枠」)
# LLM_OVERFLOW=pause
# FREE_QUOTA_RATIO=0.9
