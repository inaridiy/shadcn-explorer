{
  "name": "@shadcn-explorer/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types src/worker-configuration.d.ts --strict-vars=false",
    "db:migrate:local": "wrangler d1 migrations apply shadcn-explorer --local",
    "db:migrate:remote": "wrangler d1 migrations apply shadcn-explorer --remote",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.6",
    "@cloudflare/playwright": "^1.3.6",
    "@shadcn-explorer/core": "workspace:*",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-start": "^1.168.59",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^3.22.2",
    "hono": "^4.13.9",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.3.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.142.0"
  }
}
